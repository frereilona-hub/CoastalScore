<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>CoastalScore — Climate Risk Intelligence</title>
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">
<style>
:root{--navy:#071b35;--blue:#1677ff;--cyan:#35c8d8;--ink:#10233f;--muted:#687990;--line:#e2eaf3;--bg:#f4f8fd;--green:#0d9b72;--amber:#e5a018;--red:#dc4b4b}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink);font-family:Inter,system-ui,-apple-system,Segoe UI,Arial,sans-serif}button,input{font:inherit}button{cursor:pointer}.app{min-height:100vh}.side{position:fixed;inset:0 auto 0 0;width:238px;padding:25px 14px;background:linear-gradient(180deg,#071b35,#10385e);color:white;z-index:20}.logo{font-size:21px;font-weight:900;letter-spacing:1.5px;padding:0 10px}.tag{font-size:11px;line-height:1.5;color:#a9bfd7;margin:7px 10px 30px}.nav button{width:100%;padding:12px;border:0;border-radius:10px;background:transparent;color:#bdcde0;text-align:left;margin:3px 0}.nav button.active,.nav button:hover{background:#1677ff;color:white}.main{margin-left:238px}.top{height:72px;position:sticky;top:0;z-index:10;background:#ffffffed;backdrop-filter:blur(12px);border-bottom:1px solid var(--line);display:flex;align-items:center;gap:12px;padding:12px 28px}.search{display:flex;max-width:720px;flex:1}.search input{min-width:0;flex:1;padding:12px 14px;border:1px solid var(--line);border-radius:10px 0 0 10px;outline:none}.primary{border:0;background:linear-gradient(135deg,#1677ff,#1258c8);color:white;font-weight:750;padding:0 18px;border-radius:0 10px 10px 0}.lang{border:1px solid var(--line);background:white;padding:10px 12px;border-radius:9px}.page{max-width:1500px;margin:auto;padding:28px}.hero{padding:42px;border-radius:24px;color:white;background:radial-gradient(circle at 85% 10%,#35c8d833,transparent 35%),linear-gradient(120deg,#071b35,#104a78);box-shadow:0 16px 45px #10233f18}.eyebrow{font-size:11px;letter-spacing:1.5px;font-weight:800;color:#a9d9f5}.hero h1{font-size:clamp(34px,4vw,56px);line-height:1.03;letter-spacing:-1.8px;max-width:760px;margin:14px 0}.hero p{max-width:690px;color:#d3e4f4;line-height:1.7}.hero .search{margin-top:24px;max-width:780px}.pillrow{display:flex;gap:9px;flex-wrap:wrap;margin:18px 0 25px}.pill{font-size:11px;font-weight:800;padding:8px 11px;border-radius:30px;background:#e7f1ff;color:#155fc7}.pill.warn{background:#fff4db;color:#8c5d00}.section-title{font-size:20px;font-weight:800;margin:28px 0 14px}.grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}.card{background:white;border:1px solid var(--line);border-radius:16px;padding:20px;box-shadow:0 7px 25px #0b1f3a08;min-width:0}.card h3{margin:0 0 12px;font-size:16px}.stat{font-size:30px;font-weight:850;letter-spacing:-1px}.muted{font-size:12px;color:var(--muted);line-height:1.6}.hidden{display:none!important}.report{display:grid;grid-template-columns:1fr 1fr;gap:16px}.score-card{display:flex;gap:20px;align-items:center}.score{width:110px;height:110px;flex:0 0 110px;border:11px solid var(--amber);border-radius:50%;display:grid;place-items:center;font-size:38px;font-weight:900}.risk{margin:13px 0}.risk-head,.line{display:flex;justify-content:space-between;gap:12px;font-size:12px;margin-bottom:7px}.bar{height:8px;border-radius:10px;background:#edf2f8;overflow:hidden}.fill{height:100%;background:linear-gradient(90deg,#35c8d8,#1677ff);border-radius:10px}.stats-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.mini{background:#f7faff;border:1px solid var(--line);border-radius:12px;padding:12px}.mini strong{display:block;margin-top:6px;font-size:16px}.mapwrap{position:relative}#realRiskMap{height:370px;border-radius:12px;border:1px solid var(--line);z-index:1}.map-badge{position:absolute;right:12px;top:12px;z-index:500;background:white;border:1px solid var(--line);border-radius:10px;padding:9px 12px;font-weight:800;box-shadow:0 4px 18px #10233f15}.legend{display:flex;gap:12px;flex-wrap:wrap;font-size:11px;color:var(--muted);margin-top:10px}.dot{display:inline-block;width:8px;height:8px;border-radius:50%;margin-right:4px}.notice{padding:12px;border:1px solid #f0d99a;background:#fff9e9;border-radius:10px;color:#785700;font-size:12px;line-height:1.5}.good{padding:12px;border:1px solid #c8eee0;background:#effaf6;border-radius:10px;color:#17694f;font-size:12px}.tablewrap{overflow:auto}table{width:100%;border-collapse:collapse;font-size:13px}th,td{text-align:left;padding:13px;border-bottom:1px solid var(--line);white-space:nowrap}th{color:var(--muted);font-size:11px;text-transform:uppercase;letter-spacing:.5px}.investment-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px}.calc-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}.field label{display:block;color:var(--muted);font-size:11px;margin-bottom:5px}.field input{width:100%;padding:10px;border:1px solid var(--line);border-radius:8px}.metrics{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px}.metric{padding:13px;border:1px solid var(--line);border-radius:10px}.metric strong{display:block;font-size:20px;margin-top:5px}.btn{padding:10px 13px;border:1px solid var(--line);background:white;border-radius:9px;font-weight:700}.price-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px}.price strong{font-size:28px}.price button{width:100%;padding:11px;margin-top:12px;border:0;border-radius:8px;background:var(--blue);color:white}.featured{border:2px solid var(--blue)}footer{padding:25px 0;color:var(--muted);font-size:11px;display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap}.toast{position:fixed;bottom:20px;right:20px;z-index:99;background:var(--navy);color:white;padding:13px 17px;border-radius:10px;max-width:330px;box-shadow:0 10px 30px #0002}.loading{opacity:.65}@media(max-width:1050px){.grid,.price-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.report,.investment-grid{grid-template-columns:1fr}}@media(max-width:720px){.side{position:static;width:auto;padding:12px}.logo{font-size:18px}.tag{margin-bottom:10px}.nav{display:flex;overflow:auto}.nav button{white-space:nowrap;width:auto;flex:0 0 auto}.main{margin:0}.top{padding:10px;height:auto}.page{padding:14px}.hero{padding:26px 20px}.grid,.price-grid{grid-template-columns:1fr}.score-card{align-items:flex-start}.score{width:88px;height:88px;flex-basis:88px;font-size:30px;border-width:8px}.calc-grid,.metrics{grid-template-columns:1fr 1fr}#realRiskMap{height:300px}}
</style></head>
<body><div class="app"><aside class="side"><div class="logo">COASTALSCORE</div><div class="tag">CLIMATE RISK INTELLIGENCE FOR REAL ESTATE</div><nav class="nav"><button class="active" onclick="showPage('home',this)">⌂ &nbsp;Home</button><button onclick="showPage('report',this)">⌕ &nbsp;Search</button><button onclick="showPage('compare',this)">⇄ &nbsp;Compare</button><button onclick="showPage('portfolio',this)">▣ &nbsp;Portfolio</button><button onclick="showPage('investment',this)">↗ &nbsp;Investment</button><button onclick="showPage('pricing',this)">◇ &nbsp;Pricing</button></nav></aside>
<main class="main"><header class="top"><div class="search"><input id="topAddress" value="1200 Brickell Avenue, Miami, FL, USA" aria-label="Property address"><button class="primary" onclick="analyze('top')">Analyze</button></div><button class="lang" id="langBtn" onclick="toggleLang()">FR</button></header><div class="page">
<section id="home"><div class="hero"><div class="eyebrow">PROPERTY INTELLIGENCE · FLORIDA</div><h1 id="heroTitle">Know the risk. Before you buy.</h1><p id="heroText">Explore property climate exposure and investment sensitivity before making a real-estate decision. Start with an address in Miami-Dade County.</p><div class="search"><input id="heroAddress" value="1200 Brickell Avenue, Miami, FL, USA" placeholder="Enter a property address"><button class="primary" onclick="analyze('hero')">ANALYZE PROPERTY</button></div></div><div class="pillrow"><span class="pill">CLIMATE + INVESTMENT CONTEXT</span><span class="pill">MAP-BASED SCREENING</span><span class="pill warn">PROTOTYPE — VERIFY BEFORE DECISIONS</span></div><div class="section-title">What CoastalScore evaluates</div><div class="grid"><div class="card"><div class="stat">Flood</div><b>🌊 Flood exposure</b><p class="muted">Look up available public flood-zone mapping for the searched location.</p></div><div class="card"><div class="stat">Storm</div><b>🌀 Storm & coastal hazards</b><p class="muted">Identify where official hazard layers and local verification are needed.</p></div><div class="card"><div class="stat">Investment</div><b>⌂ Investment sensitivity</b><p class="muted">Test how rent, operating costs, vacancy and financing assumptions affect cash flow.</p></div></div><div class="section-title">Designed for real-estate decisions</div><div class="grid"><div class="card"><h3>01 · Find a property</h3><p class="muted">Search an address and see the location on an interactive map.</p></div><div class="card"><h3>02 · Review the evidence</h3><p class="muted">See the status of available public data. Missing data is labelled, not replaced by invented measurements.</p></div><div class="card"><h3>03 · Stress-test the deal</h3><p class="muted">Run an editable rental scenario separately from the climate screening.</p></div></div></section>
<section id="report" class="hidden"><div class="section-title">Property Intelligence Report</div><div class="report"><div class="card score-card"><div class="score" id="overallScore">—</div><div><div class="muted">CLIMATE SCREENING</div><h2 id="propertyName" style="margin:7px 0">Property not analyzed</h2><div id="riskLabel"><b>Awaiting address lookup</b></div><p class="muted" id="propertyLocation">Search an address to begin.</p></div></div><div class="card"><h3>Climate indicators</h3><div id="risks"><p class="muted">No property-specific score is calculated until suitable data is available.</p></div><p id="floodDataNote" class="muted">Flood zone lookup has not been run.</p></div><div class="card"><h3>Neighborhood snapshot</h3><p class="muted">Contextual information is shown only when a public source returns it. These are not a substitute for official local checks.</p><div class="stats-grid"><div class="mini"><span class="muted">Neighborhood</span><strong id="neighborhoodValue">Not loaded</strong></div><div class="mini"><span class="muted">Population</span><strong id="populationValue">Not connected</strong></div><div class="mini"><span class="muted">Education</span><strong id="educationValue">Not connected</strong></div><div class="mini"><span class="muted">Crime</span><strong id="crimeValue">Not connected</strong></div></div><p id="neighborhoodDataNote" class="muted">Neighborhood indicators are not yet verified.</p></div><div class="card"><h3>Interactive property map</h3><div class="mapwrap"><div id="realRiskMap" aria-label="Interactive Miami property map"></div><div class="map-badge">LOCATION <span id="mapLocationState">PREVIEW</span></div></div><div class="legend"><span><i class="dot" style="background:#0d9b72"></i>Lower mapped hazard</span><span><i class="dot" style="background:#e5a018"></i>Moderate</span><span><i class="dot" style="background:#dc4b4b"></i>Higher</span></div><p class="muted">The marker indicates the geocoded address. No flood polygons are drawn unless a verified layer is available.</p></div><div class="card"><h3>Evidence & data quality</h3><div class="line"><span>Address geocoding</span><b id="geocodeStatus">Not run</b></div><div class="line"><span>Miami-Dade flood layer</span><b id="floodStatus">Not checked</b></div><div class="line"><span>Neighborhood metrics</span><b>Not connected</b></div><div class="line"><span>Overall climate score</span><b>Not validated</b></div><div class="notice" style="margin-top:14px">Important: a flood-zone result is a screening aid, not an insurance quote, elevation certificate, engineering assessment, or guarantee that a property will or will not flood.</div></div><div class="card"><h3>Before making an offer</h3><div class="line"><span>Confirm FEMA flood zone</span><b>Required</b></div><div class="line"><span>Request elevation certificate</span><b>If applicable</b></div><div class="line"><span>Check wind mitigation & roof</span><b>Required</b></div><div class="line"><span>Obtain property-specific insurance quotes</span><b>Required</b></div><div class="line"><span>Verify taxes, HOA and inspections</span><b>Required</b></div></div></div></section>
<section id="compare" class="hidden"><div class="section-title">Compare Miami areas</div><div class="card"><p class="muted">These are neighborhood search examples, not risk rankings. Run an address search for each candidate and compare official records before deciding.</p><div class="tablewrap"><table><thead><tr><th>Area</th><th>Example search</th><th>Next verification</th></tr></thead><tbody><tr><td>Brickell</td><td><button class="btn" onclick="quickSearch('Brickell, Miami, FL, USA')">Analyze area</button></td><td>Flood zone, building and elevation</td></tr><tr><td>Wynwood</td><td><button class="btn" onclick="quickSearch('Wynwood, Miami, FL, USA')">Analyze area</button></td><td>Parcel-level flood exposure</td></tr><tr><td>Little Havana</td><td><button class="btn" onclick="quickSearch('Little Havana, Miami, FL, USA')">Analyze area</button></td><td>Parcel-level flood exposure</td></tr><tr><td>Coral Gables</td><td><button class="btn" onclick="quickSearch('Coral Gables, FL, USA')">Analyze area</button></td><td>Flood zone and drainage</td></tr><tr><td>Miami Beach</td><td><button class="btn" onclick="quickSearch('Miami Beach, FL, USA')">Analyze area</button></td><td>Coastal flooding and elevation</td></tr></tbody></table></div></div></section>
<section id="portfolio" class="hidden"><div class="section-title">Portfolio workspace</div><div class="card"><h3>Start a verified portfolio</h3><p class="muted">This prototype does not invent properties, risk scores or portfolio totals. Analyze an address, then export the summary for your own records.</p><button class="btn" onclick="showPage('report',document.querySelectorAll('.nav button')[1])">Open property report</button></div></section>
<section id="investment" class="hidden"><div class="section-title">Investment & profitability</div><div class="investment-grid"><div class="card"><h3>Editable assumptions (USD)</h3><p class="muted">All starting values below are examples only. Replace them with property-specific figures.</p><div class="calc-grid"><div class="field"><label>Purchase price ($)</label><input id="priceInput" type="number" value="450000" oninput="calculateInvestment()"></div><div class="field"><label>Monthly rent ($)</label><input id="rentInput" type="number" value="3500" oninput="calculateInvestment()"></div><div class="field"><label>Annual property tax ($)</label><input id="taxInput" type="number" value="7000" oninput="calculateInvestment()"></div><div class="field"><label>Annual insurance ($)</label><input id="insuranceInput" type="number" value="6000" oninput="calculateInvestment()"></div><div class="field"><label>Annual maintenance ($)</label><input id="maintenanceInput" type="number" value="3000" oninput="calculateInvestment()"></div><div class="field"><label>Other annual costs ($)</label><input id="otherInput" type="number" value="1500" oninput="calculateInvestment()"></div><div class="field"><label>Vacancy rate (%)</label><input id="vacancyInput" type="number" value="5" min="0" max="100" step="0.5" oninput="calculateInvestment()"></div><div class="field"><label>Management fee (%)</label><input id="managementInput" type="number" value="8" min="0" max="100" step="0.5" oninput="calculateInvestment()"></div><div class="field"><label>Monthly mortgage ($)</label><input id="mortgageInput" type="number" value="2000" oninput="calculateInvestment()"></div><div class="field"><label>Initial works ($)</label><input id="worksInput" type="number" value="15000" oninput="calculateInvestment()"></div><div class="field"><label>Down payment ($)</label><input id="downPaymentInput" type="number" value="90000" oninput="calculateInvestment()"></div><div class="field"><label>Closing costs (%)</label><input id="closingInput" type="number" value="3" min="0" max="20" step="0.5" oninput="calculateInvestment()"></div></div></div><div class="card"><div class="muted">INVESTMENT SCENARIO SCORE · ILLUSTRATIVE</div><div class="stat" id="investmentScore">—</div><h3 id="investmentVerdict">Enter assumptions</h3><div class="metrics"><div class="metric"><span class="muted">Gross yield</span><strong id="grossYield">—</strong></div><div class="metric"><span class="muted">Net yield</span><strong id="netYield">—</strong></div><div class="metric"><span class="muted">Cash flow / month</span><strong id="cashFlow">—</strong></div></div><div style="margin-top:16px" class="line"><span>Annual rent after vacancy</span><b id="effectiveRent">—</b></div><div class="line"><span>Operating costs</span><b id="annualCosts">—</b></div><div class="line"><span>Net operating income</span><b id="noi">—</b></div><div class="line"><span>Cash invested (estimate)</span><b id="totalCash">—</b></div><div class="notice" style="margin-top:15px">This is a user-input calculator, not market data or financial advice. Financing, HOA fees, special assessments, taxes and insurance must be verified for the property.</div></div><div class="card"><h3>Insurance sensitivity scenario</h3><p class="muted">Not insurance pricing. Shows what happens if your own entered premium changes.</p><div class="line"><span>Entered annual premium</span><b id="insuranceBase">—</b></div><div class="line"><span>Premium +25%</span><b id="insurance25">—</b></div><div class="line"><span>Premium +50%</span><b id="insurance50">—</b></div><div class="line"><span>Monthly cash flow after +50%</span><b id="cashAfterInsurance50">—</b></div></div><div class="card"><h3>Investor checklist</h3><p class="muted">☐ Obtain a written insurance quote<br>☐ Confirm flood zone and elevation<br>☐ Verify property taxes and HOA costs<br>☐ Review roof age and wind mitigation<br>☐ Validate rent with comparable properties<br>☐ Include vacancy, repairs and management</p><button class="btn" onclick="window.print()">Print this scenario</button> <button class="btn" onclick="exportReport()">Export summary</button></div></div></section>
<section id="pricing" class="hidden"><div class="section-title">Prototype pricing concepts</div><p class="muted">Pricing is for product validation only; checkout and subscriptions are not connected.</p><div class="price-grid"><div class="card price"><h3>Free Preview</h3><strong>$0</strong><p class="muted">Basic address lookup and source status.</p><button onclick="toast('Demo only — no checkout is connected.')">Explore</button></div><div class="card price"><h3>Property Report</h3><strong>$29</strong><p class="muted">Concept: exportable property screening report.</p><button onclick="toast('Demo only — no payment is connected.')">Preview offer</button></div><div class="card price featured"><h3>Professional</h3><strong>$99</strong><p class="muted">Concept: multiple property comparisons.</p><button onclick="toast('Demo only — no subscription is connected.')">Preview offer</button></div><div class="card price"><h3>Investor</h3><strong>$299</strong><p class="muted">Concept: portfolio workflows and team reporting.</p><button onclick="toast('Demo only — no subscription is connected.')">Preview offer</button></div></div></section>
<footer><span><b>COASTALSCORE</b> · Climate risk intelligence for real estate</span><span>Prototype · Not financial, insurance, legal or engineering advice</span></footer></div></main></div><div id="toast" class="toast hidden" role="status"></div>
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script><script>
const $=id=>document.getElementById(id);let map=null,marker=null,coords=null,lastAddress='1200 Brickell Avenue, Miami, FL, USA',language='en',toastTimer=null;
function toast(message){const el=$('toast');el.textContent=message;el.classList.remove('hidden');clearTimeout(toastTimer);toastTimer=setTimeout(()=>el.classList.add('hidden'),4200)}
function showPage(id,btn){document.querySelectorAll('.page>section').forEach(s=>s.classList.add('hidden'));$(id).classList.remove('hidden');document.querySelectorAll('.nav button').forEach(b=>b.classList.remove('active'));if(btn)btn.classList.add('active');if(id==='report')setTimeout(()=>{initMap();if(map)map.invalidateSize()},150);window.scrollTo({top:0,behavior:'smooth'})}
function initMap(){if(map||!$('realRiskMap')||typeof L==='undefined')return;map=L.map('realRiskMap').setView([25.7617,-80.1918],11);L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png',{maxZoom:19,attribution:'© OpenStreetMap contributors'}).addTo(map);}
function updateMap(lat,lon,label){initMap();if(!map)return;coords={lat,lon};if(marker)marker.remove();marker=L.marker([lat,lon]).addTo(map).bindPopup(label||'Analyzed location').openPopup();map.setView([lat,lon],15);$('mapLocationState').textContent='LOCATED';setTimeout(()=>map.invalidateSize(),100)}
function riskBar(label,value){return `<div class="risk"><div class="risk-head"><span>${label}</span><b>${value}/100</b></div><div class="bar"><div class="fill" style="width:${value}%"></div></div></div>`}
function setClimateUnavailable(message){$('overallScore').textContent='—';$('riskLabel').innerHTML='<b>Insufficient verified data</b>';$('risks').innerHTML='<p class="muted">No combined score shown: verified data for all components is not yet available.</p>';$('floodDataNote').textContent=message;}
async function analyze(source='top'){const input=$(source==='hero'?'heroAddress':'topAddress'),other=$(source==='hero'?'topAddress':'heroAddress'),address=input.value.trim();if(!address){toast('Please enter a property address.');return}other.value=address;lastAddress=address;$('propertyName').textContent=address.split(',')[0];$('propertyLocation').textContent='Looking up address…';$('geocodeStatus').textContent='Loading…';$('floodStatus').textContent='Loading…';$('neighborhoodDataNote').textContent='Loading neighborhood name from OpenStreetMap…';showPage('report',document.querySelectorAll('.nav button')[1]);toast('Looking up address and available public flood data…');try{
 const geoUrl='https://geocode.arcgis.com/arcgis/rest/services/World/GeocodeServer/findAddressCandidates?f=json&maxLocations=1&outFields=*&singleLine='+encodeURIComponent(address);
 const response=await fetch(geoUrl);if(!response.ok)throw new Error('Geocoder request failed ('+response.status+')');const data=await response.json();const candidate=data.candidates&&data.candidates[0];if(!candidate||candidate.score<70)throw new Error('Address not found. Try a full address in Miami-Dade County.');const loc=candidate.location,lat=loc.y,lon=loc.x,label=candidate.address||address;$('geocodeStatus').textContent='Located';$('propertyLocation').textContent=label;updateMap(lat,lon,label);setClimateUnavailable('A map location was found. The flood-zone query will be checked separately; no composite climate score is invented.');
 try{const geometry=encodeURIComponent(JSON.stringify({x:lon,y:lat,spatialReference:{wkid:4326}}));const floodUrl='https://gis.miamidade.gov/arcgis/rest/services/EnerGov/MD_LandMgtViewer/MapServer/63/query?f=json&where=1%3D1&geometry='+geometry+'&geometryType=esriGeometryPoint&inSR=4326&spatialRel=esriSpatialRelIntersects&outFields=*&returnGeometry=false';const fr=await fetch(floodUrl);if(!fr.ok)throw new Error('Flood layer request failed');const fd=await fr.json();if(fd.error)throw new Error(fd.error.message||'Flood layer error');const feature=fd.features&&fd.features[0];if(feature){const attrs=feature.attributes||{};const fields=Object.entries(attrs).filter(([k,v])=>v!==null&&v!==''&&!/objectid|shape|globalid/i.test(k)).slice(0,8).map(([k,v])=>`${k}: ${v}`).join(' · ');$('floodStatus').textContent='Feature returned';$('floodDataNote').textContent='Miami-Dade GIS layer returned a feature at this point: '+(fields||'attributes available')+'. Confirm the layer’s field definitions and cross-check with FEMA before relying on this result.';$('risks').innerHTML='<div class="good">A feature was returned by the Miami-Dade GIS layer. This is a raw map-layer result, not a validated risk score.</div>';}else{$('floodStatus').textContent='No feature returned';$('floodDataNote').textContent='No feature was returned by the selected Miami-Dade GIS layer at this point. This does not prove the property is outside a flood hazard area; check the official FEMA map.';$('risks').innerHTML='<div class="notice">No matching feature in this layer. Do not interpret this as zero flood risk.</div>'}}
 catch(e){$('floodStatus').textContent='Unavailable';$('floodDataNote').textContent='The Miami-Dade flood-layer request failed or returned an unexpected response. Check the official FEMA map directly. Details: '+e.message;$('risks').innerHTML='<div class="notice">Flood data could not be verified in this session. No flood score has been generated.</div>'}
 try{const rev='https://nominatim.openstreetmap.org/reverse?format=jsonv2&lat='+encodeURIComponent(lat)+'&lon='+encodeURIComponent(lon)+'&zoom=18&addressdetails=1';const rr=await fetch(rev,{headers:{Accept:'application/json'}});if(!rr.ok)throw new Error('Reverse lookup failed');const rd=await rr.json(),a=rd.address||{},n=a.neighbourhood||a.quarter||a.city_district||a.suburb||a.residential||a.city||'Not identified';$('neighborhoodValue').textContent=n;$('neighborhoodDataNote').textContent='Neighborhood label from OpenStreetMap. Population, education and crime indicators are not connected.'}catch(e){$('neighborhoodValue').textContent='Unavailable';$('neighborhoodDataNote').textContent='Neighborhood label could not be loaded. Population, education and crime indicators remain unconnected.'}
 toast('Address located. Review the source status in the report.');
 }catch(e){$('geocodeStatus').textContent='Failed';$('propertyLocation').textContent='Address could not be verified';$('floodStatus').textContent='Not checked';setClimateUnavailable('Address lookup failed: '+e.message+'. Check your connection or try a complete Miami-Dade address.');toast('Address lookup failed: '+e.message)} }
function quickSearch(address){$('topAddress').value=address;analyze('top')}
function money(n){return '$'+Math.round(n).toLocaleString('en-US')}
function calculateInvestment(){const num=id=>Math.max(0,Number($(id).value)||0);const price=num('priceInput'),rent=num('rentInput'),tax=num('taxInput'),insurance=num('insuranceInput'),maintenance=num('maintenanceInput'),other=num('otherInput'),mortgage=num('mortgageInput'),works=num('worksInput'),down=num('downPaymentInput'),closing=num('closingInput'),vacancy=Math.min(100,num('vacancyInput')),management=Math.min(100,num('managementInput'));const annualRent=rent*12,effective=annualRent*(1-vacancy/100),managementCost=effective*management/100,costs=tax+insurance+maintenance+other+managementCost,noi=effective-costs,cash=noi/12-mortgage,gross=price?annualRent/price*100:0,net=price?noi/price*100:0,totalCash=down+price*closing/100+works;let score=price&&rent?Math.max(0,Math.min(100,Math.round(50+(gross-5)*4+(net-3)*3+Math.min(10,cash/100)-Math.min(10,works/5000)))):null;$('investmentScore').textContent=score===null?'—':score+'/100';$('investmentVerdict').textContent=score===null?'Enter assumptions':score>=75?'Positive scenario — verify all costs':score>=55?'Mixed scenario — stress-test costs':'Weak scenario under these assumptions';$('grossYield').textContent=gross.toFixed(1)+'%';$('netYield').textContent=net.toFixed(1)+'%';$('cashFlow').textContent=(cash>=0?'+':'−')+money(Math.abs(cash));$('effectiveRent').textContent=money(effective);$('annualCosts').textContent=money(costs);$('noi').textContent=money(noi);$('totalCash').textContent=money(totalCash);$('insuranceBase').textContent=money(insurance);$('insurance25').textContent=money(insurance*1.25);$('insurance50').textContent=money(insurance*1.5);const after50=cash-insurance*.5/12;$('cashAfterInsurance50').textContent=(after50>=0?'+':'−')+money(Math.abs(after50))+'/mo'}
function exportReport(){const content=['CoastalScore — Investor Summary','Property: '+lastAddress,'Address geocoding: '+$('geocodeStatus').textContent,'Flood layer: '+$('floodStatus').textContent,'Flood notes: '+$('floodDataNote').textContent,'Neighborhood: '+$('neighborhoodValue').textContent,'Investment scenario score: '+$('investmentScore').textContent,'Gross yield: '+$('grossYield').textContent,'Net yield: '+$('netYield').textContent,'Cash flow/month: '+$('cashFlow').textContent,'Note: prototype screening only; verify all sources and property-specific costs.'].join('\n');const blob=new Blob([content],{type:'text/plain;charset=utf-8'}),url=URL.createObjectURL(blob),a=document.createElement('a');a.href=url;a.download='coastalscore-summary.txt';a.click();URL.revokeObjectURL(url)}
function toggleLang(){language=language==='en'?'fr':'en';$('langBtn').textContent=language==='en'?'FR':'EN';if(language==='fr'){$('heroTitle').textContent='Comprendre le risque avant d’acheter.';$('heroText').textContent='Explorez l’exposition climatique et la sensibilité financière d’un bien avant une décision immobilière. Commencez par une adresse dans le comté de Miami-Dade.';toast('Aperçu français activé pour le titre et le texte principal.')}else{$('heroTitle').textContent='Know the risk. Before you buy.';$('heroText').textContent='Explore property climate exposure and investment sensitivity before making a real-estate decision. Start with an address in Miami-Dade County.';toast('English preview restored.')}}
calculateInvestment();initMap();
</script></body></html>
